  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB2E4\uC74C\uC758 \uACBD\uC6B0, \uB450 \uD50C\uB808\uC774\uC5B4\uB294
    \uB3D9\uC810!\r\n- <color=#e54b4b><b>\uD1F4\uCCAD</b></color> \uD50C\uB808\uC774\uC5B4\uAC00
    2\uBA85\uC778 \uACBD\uC6B0 (\uC55E\uC5D0\uC11C 2\uBA85\uC774 \uBAA8\uB450 <color=#e54b4b><b>\uD1F4\uCCAD</b></color>\uD55C
    \uACBD\uC6B0 \uB9C8\uC9C0\uB9C9\uC73C\uB85C\r\n\uACB0\uC815\uD558\uB294 \uD50C\uB808\uC774\uC5B4\uB294
    \uC790\uB3D9\uC73C\uB85C <color=#01baef><b>\uCC38\uAC00</b></color>\uB3FC\uC694)\r\n-
    <color=#01baef><b>\uCC38\uAC00</b></color>\uD55C \uB450 \uD50C\uB808\uC774\uC5B4\uC758
    \uC871\uBCF4\uAC00 \uAC19\uC740 \uACBD\uC6B0 (<color=#e54b4b><b>\uD1F4\uCCAD</b></color>\uD55C
    \uD50C\uB808\uC774\uC5B4\uC758 \uC871\uBCF4\uB294 \uADF8\uBCF4\uB2E4\r\n\uB0AE\uC544\uC57C
    \uD574\uC694)\r\n\n1. \uBC1B\uC740 \uCE74\uB4DC 2\uC7A5 \uC911 1\uC7A5\uC744
    \uAD50\uD658\uD560 \uC218 \uC788\uC5B4\uC694.\r\n2. <color=#e3b23c><b>\"\uB371\uC5D0\uC11C
    \uAD50\uD658\"</b></color>, <color=#e3b23c><b>\"\uC0C1\uB300\uC640 \uAD50\uD658\"</b></color>\uC774
    \uAC01\uAC01 1\uD68C \uAC00\uB2A5\uD574\uC694. \uAF2D \uAD50\uD658\uD558\uC9C0
    \uC54A\uC544\uB3C4\r\n\uAD1C\uCC2E\uC544\uC694.\r\n3. \uCD5C\uC885 \uACB0\uC815\uB41C
    \uCE74\uB4DC 2\uC7A5\uC758 \uC871\uBCF4\uC758 \uB192\uB0AE\uC774\uB85C \uC2B9\uD328\uAC00
    \uACB0\uC815\uB3FC\uC694!"
